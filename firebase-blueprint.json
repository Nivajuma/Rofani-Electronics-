{
  "entities": {
    "StoreProfile": {
      "title": "StoreProfile",
      "description": "Multi-tenant store workspace profile and SaaS subscription state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 200 },
        "storeName": { "type": "string", "maxLength": 200 },
        "branchName": { "type": "string", "maxLength": 200 },
        "businessType": { "type": "string", "enum": ["boutique", "salon", "hardware", "hospitality", "general", "electronics", "pharmacy"] },
        "phone": { "type": "string", "maxLength": 64 },
        "kraPin": { "type": "string", "maxLength": 64 },
        "mpesaShortcode": { "type": "string", "maxLength": 64 },
        "mpesaShortcodeType": { "type": "string", "enum": ["till", "paybill"] },
        "mpesaStoreNumber": { "type": "string", "maxLength": 64 },
        "planType": { "type": "string", "enum": ["trial", "monthly", "quarterly", "biannual", "annual"] },
        "subscriptionStatus": { "type": "string", "enum": ["trial", "active", "expired", "suspended"] },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "expiryDate": { "type": "string", "maxLength": 64 },
        "lastPaymentRef": { "type": "string", "maxLength": 128 },
        "lastPaymentAmount": { "type": "number" },
        "lastPaymentAt": { "type": "string", "maxLength": 64 },
        "lastPaymentPhone": { "type": "string", "maxLength": 64 },
        "lastPaymentMethod": { "type": "string", "enum": ["stk_push", "manual_receipt", "admin_override", "free_trial"] },
        "referralCode": { "type": "string", "maxLength": 32 },
        "referredBy": { "type": "string", "maxLength": 128 },
        "referredByCode": { "type": "string", "maxLength": 32 },
        "referredByStoreName": { "type": "string", "maxLength": 200 },
        "referralCount": { "type": "number" },
        "trialDaysGranted": { "type": "number" },
        "lastReferralBonusAt": { "type": "string", "maxLength": 64 },
        "lastReferralRewardStoreName": { "type": "string", "maxLength": 200 },
        "taxMode": { "type": "string", "enum": ["none", "tot", "vat"] },
        "transactionWiseTax": { "type": "boolean" },
        "skipLegacySeed": { "type": "boolean" },
        "preferredLabelSizeId": { "type": "string", "maxLength": 64 },
        "businessCard": { "type": "object", "description": "Per-store digital business card profile (owner info, photo/logo, shop name, contact, referral URL)" },
        "backupEmail": { "type": "string", "maxLength": 200 },
        "backupEmailConfirmed": { "type": "boolean" },
        "emailAutoBackupEnabled": { "type": "boolean" },
        "dismissedBackupBannerDate": { "type": "string", "maxLength": 32 },
        "isMultiBranch": { "type": "boolean" },
        "businessGroupId": { "type": "string", "maxLength": 128 },
        "businessGroupName": { "type": "string", "maxLength": 200 },
        "parentStoreId": { "type": "string", "maxLength": 128 },
        "isBranchStore": { "type": "boolean" },
        "isPrimaryBranch": { "type": "boolean" },
        "maxAllowedBranches": { "type": "number" },
        "licensePendingActivation": { "type": "boolean" },
        "branchCode": { "type": "string", "maxLength": 32 },
        "branchCity": { "type": "string", "maxLength": 120 },
        "branchAddress": { "type": "string", "maxLength": 200 },
        "branchManagerName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerUid", "ownerEmail", "storeName", "planType", "subscriptionStatus", "expiresAt"]
    },
    "ReferralCodeIndex": {
      "title": "ReferralCodeIndex",
      "description": "Non-PII lookup index mapping a merchant referral code to its storeId",
      "type": "object",
      "properties": {
        "code": { "type": "string", "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128 },
        "storeName": { "type": "string", "maxLength": 200 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["code", "storeId", "storeName", "ownerUid"]
    },
    "ReferralRewardClaim": {
      "title": "ReferralRewardClaim",
      "description": "Idempotent record of a 30-day referral bonus credited to a referrer store",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referrerStoreId": { "type": "string", "maxLength": 128 },
        "referredStoreId": { "type": "string", "maxLength": 128 },
        "referredStoreName": { "type": "string", "maxLength": 200 },
        "referralCode": { "type": "string", "maxLength": 32 },
        "bonusDays": { "type": "number" },
        "applied": { "type": "boolean" },
        "appliedAt": { "type": "string", "maxLength": 64 },
        "awardedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "referrerStoreId", "referredStoreId", "bonusDays", "applied", "awardedAt"]
    },
    "SubscriptionPayment": {
      "title": "SubscriptionPayment",
      "description": "Recorded M-Pesa subscription payment or manual receipt for a tenant store",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128 },
        "planType": { "type": "string", "enum": ["monthly", "quarterly", "biannual", "annual"] },
        "amount": { "type": "number" },
        "phoneNumber": { "type": "string", "maxLength": 64 },
        "mpesaReceiptNumber": { "type": "string", "maxLength": 128 },
        "paymentMethod": { "type": "string", "enum": ["stk_push", "manual_receipt", "admin_override"] },
        "status": { "type": "string", "enum": ["Completed", "Pending", "Failed"] },
        "paidAt": { "type": "string", "maxLength": 64 },
        "expiresAtAfter": { "type": "string", "maxLength": 64 },
        "recordedByEmail": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "storeId", "planType", "amount", "mpesaReceiptNumber", "paidAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory product item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 300 },
        "sku": { "type": "string", "maxLength": 128 },
        "barcode": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 128 },
        "subcategory": { "type": "string", "maxLength": 128 },
        "sellingPrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "stockQuantity": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "unit": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Sales transaction receipt",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiptNumber": { "type": "string", "maxLength": 128 },
        "grandTotal": { "type": "number" },
        "amountPaid": { "type": "number" },
        "balanceDue": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Partial", "Unpaid"] },
        "date": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "receiptNumber", "grandTotal"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 64 },
        "currentBalanceDue": { "type": "number" },
        "depositBalance": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "CustomerDeposit": {
      "title": "CustomerDeposit",
      "description": "Customer advance deposit, partial payment settlement, or store credit application",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "receiptRef": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["deposit", "partial_payment", "deposit_applied", "refund_credit"] },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 64 },
        "date": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerId", "amount", "type"]
    },
    "CustomerComplaint": {
      "title": "CustomerComplaint",
      "description": "Customer service, product defect, or billing complaint tracker",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "complaintNumber": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 128 },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High", "Urgent"] },
        "status": { "type": "string", "enum": ["Open", "In Review", "Resolved", "Escalated"] },
        "subject": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "customerId", "subject", "status"]
    },
    "CustomerReturn": {
      "title": "CustomerReturn",
      "description": "Customer partial or full goods return, credit note, refund settlement, and stock restoration audit",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "returnNumber": { "type": "string", "maxLength": 64 },
        "creditNoteNumber": { "type": "string", "maxLength": 64 },
        "originalTransactionId": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "totalRefundAmount": { "type": "number" },
        "refundMode": { "type": "string", "maxLength": 64 },
        "restockedTotalUnits": { "type": "number" },
        "damagedTotalUnits": { "type": "number" },
        "date": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "originalTransactionId", "customerId", "totalRefundAmount"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 64 },
        "currentBalanceDue": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Store expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "amount": { "type": "number" },
        "category": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 500 },
        "date": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "amount"]
    },
    "User": {
      "title": "User",
      "description": "Staff user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "assignedBranchIds": { "type": "array", "description": "Multi-branch storeIds assigned to this staff member" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "RestockRecord": {
      "title": "RestockRecord",
      "description": "Inventory restock batch record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "maxLength": 128 },
        "productName": { "type": "string", "maxLength": 300 },
        "quantityAdded": { "type": "number" },
        "totalCost": { "type": "number" },
        "date": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "productId", "quantityAdded"]
    },
    "SensitiveActionLog": {
      "title": "SensitiveActionLog",
      "description": "Immutable security and inventory audit log entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "timestamp": { "type": "string", "maxLength": 64 },
        "actionType": { "type": "string", "maxLength": 64 },
        "actionTitle": { "type": "string", "maxLength": 300 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "timestamp", "actionType", "actionTitle"]
    },
    "StoreSetting": {
      "title": "StoreSetting",
      "description": "Store security and payment configuration document",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string", "maxLength": 64 }
      }
    },
    "FeatureRequest": {
      "title": "FeatureRequest",
      "description": "Client-submitted special feature request or custom build proposal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerEmail": { "type": "string", "maxLength": 200 },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subject": { "type": "string", "minLength": 3, "maxLength": 140 },
        "category": {
          "type": "string",
          "enum": [
            "POS & Checkout",
            "M-Pesa & Payments",
            "Inventory & Stock",
            "Reports & Tax",
            "Multi-Shop & Staff",
            "Custom Integration",
            "Other"
          ]
        },
        "priority": {
          "type": "string",
          "enum": ["Nice to Have", "Important for My Shop", "Urgent Custom Build"]
        },
        "description": { "type": "string", "minLength": 10, "maxLength": 1500 },
        "contactPhone": { "type": "string", "maxLength": 64 },
        "contactName": { "type": "string", "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["Pending", "Planned", "In Progress", "Completed", "Declined"]
        },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "ownerUid",
        "ownerEmail",
        "storeId",
        "storeName",
        "subject",
        "category",
        "priority",
        "description",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": { "$ref": "#/entities/StoreProfile" },
      "description": "Tenant store workspace metadata and SaaS subscription profile"
    },
    "/stores/{storeId}/subscription_payments/{paymentId}": {
      "schema": { "$ref": "#/entities/SubscriptionPayment" },
      "description": "Tenant subscription payment receipts (M-Pesa STK or manual confirmation)"
    },
    "/stores/{storeId}/referral_rewards/{claimId}": {
      "schema": { "$ref": "#/entities/ReferralRewardClaim" },
      "description": "Idempotent +30 day referral bonus claim records credited when a referred merchant joins"
    },
    "/referral_codes/{code}": {
      "schema": { "$ref": "#/entities/ReferralCodeIndex" },
      "description": "Lookup index resolving a clean referral code to a storeId during registration"
    },
    "/stores/{storeId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Tenant-isolated products catalog"
    },
    "/stores/{storeId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Tenant-isolated sales transactions"
    },
    "/stores/{storeId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Tenant-isolated customer profiles"
    },
    "/stores/{storeId}/customer_deposits/{depositId}": {
      "schema": { "$ref": "#/entities/CustomerDeposit" },
      "description": "Tenant-isolated customer advance deposits and partial invoice payment ledgers"
    },
    "/stores/{storeId}/customer_complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/CustomerComplaint" },
      "description": "Tenant-isolated customer complaints and resolution logs"
    },
    "/stores/{storeId}/customer_returns/{returnId}": {
      "schema": { "$ref": "#/entities/CustomerReturn" },
      "description": "Tenant-isolated customer goods returns, credit notes, and stock restoration records"
    },
    "/stores/{storeId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Tenant-isolated supplier profiles"
    },
    "/stores/{storeId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Tenant-isolated store expenses"
    },
    "/stores/{storeId}/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Tenant-isolated staff user profiles"
    },
    "/stores/{storeId}/restock_records/{recordId}": {
      "schema": { "$ref": "#/entities/RestockRecord" },
      "description": "Tenant-isolated inventory restock batches"
    },
    "/stores/{storeId}/sensitive_action_logs/{logId}": {
      "schema": { "$ref": "#/entities/SensitiveActionLog" },
      "description": "Tenant-isolated immutable audit logs"
    },
    "/stores/{storeId}/store_settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSetting" },
      "description": "Tenant-isolated store security and M-Pesa configuration documents"
    },
    "/stores/{storeId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSetting" },
      "description": "Tenant-isolated store operational settings documents (e.g. transaction rules and prefixes)"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Legacy owner root products collection"
    },
    "/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Legacy owner root transactions collection"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Legacy owner root customers collection"
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Legacy owner root suppliers collection"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Legacy owner root expenses collection"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Legacy owner root users collection"
    },
    "/restock_records/{recordId}": {
      "schema": { "$ref": "#/entities/RestockRecord" },
      "description": "Legacy owner root restock records collection"
    },
    "/sensitive_action_logs/{logId}": {
      "schema": { "$ref": "#/entities/SensitiveActionLog" },
      "description": "Legacy owner root immutable audit logs collection"
    },
    "/store_settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSetting" },
      "description": "Legacy owner root store settings collection"
    },
    "/feature_requests/{requestId}": {
      "schema": { "$ref": "#/entities/FeatureRequest" },
      "description": "Client special feature requests and custom build suggestions"
    }
  }
}
