rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email == 'NivaJuma@gmail.com'
          || request.auth.token.email.lower() == 'nivajuma@gmail.com'
        );
    }

    // Legacy root fallback so existing admin data migrates smoothly
    match /{legacyCollection}/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // Multi-tenant store isolation for friends/merchants
    match /stores/{storeId} {
      allow read, write: if request.auth != null && (request.auth.uid == storeId || isSuperAdmin());

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && (request.auth.uid == storeId || isSuperAdmin());
      }
    }
  }
}
